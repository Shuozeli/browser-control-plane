#cloud-config
# Golden image for a Browser Control Plane VirtualBox VM fleet.
# Installs a headless Chromium and authorizes an SSH key so the fleet can be
# driven entirely over SSH. Replace <SSH_PUBLIC_KEY> before use.
hostname: bcp-golden
ssh_pwauth: true
users:
  - name: cyuan
    plain_text_passwd: cyuan
    lock_passwd: false
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: [sudo]
    shell: /bin/bash
    ssh_authorized_keys:
      - <SSH_PUBLIC_KEY>
runcmd:
  - [ bash, -lc, "install -d /opt/bcp" ]
  - [ bash, -lc, "for i in $(seq 1 6); do snap install chromium && break || sleep 20; done" ]
  - [ bash, -lc, "ln -sf /snap/bin/chromium /usr/local/bin/chromium || true" ]
  - [ bash, -lc, "touch /opt/bcp/provisioned" ]
